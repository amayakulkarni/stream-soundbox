# ───────────────────────── Server ─────────────────────────
PORT=42001
# Keep 127.0.0.1 when nginx sits in front (recommended). Use 0.0.0.0 only if you
# deliberately want to reach the app directly from another machine.
HOST=127.0.0.1
# Public HTTPS origin, no trailing slash. Used for OAuth redirect URIs and for
# the webhook callback URLs you paste into Twitch / Buy Me a Coffee.
PUBLIC_URL=https://supporters.amayakulkarni.com
# Where state.json (counters, queue, log) and tokens.json (OAuth tokens) live.
DATA_DIR=data

# ───────────────────── Admin dashboard (/admin) ─────────────────────
# Required. If empty, the admin login is disabled.
ADMIN_PASSWORD=
# 32+ random characters (openssl rand -hex 32). Signs the admin session cookie.
SESSION_SECRET=
# Optional but recommended on a public domain. When set, overlay URLs need
# ?key=<this value>. The admin dashboard shows ready-to-copy URLs with it.
OVERLAY_KEY=

# ───────────────────────── YouTube ─────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorized redirect URI:  <PUBLIC_URL>/admin/auth/youtube/callback
# Enable "YouTube Data API v3". Set the consent screen to "In production",
# otherwise Google expires the refresh token after 7 days.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ───────────────────────── Twitch ─────────────────────────
# https://dev.twitch.tv/console/apps → Register Your Application.
# OAuth Redirect URL:  <PUBLIC_URL>/admin/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# 10–100 random characters. Signs EventSub webhook deliveries.
TWITCH_EVENTSUB_SECRET=

# ───────────────────── Buy Me a Coffee ─────────────────────
# Webhook URL to paste into Buy Me a Coffee:
#   <PUBLIC_URL>/webhooks/bmc?token=<BMC_WEBHOOK_TOKEN>
# Set at least one of these (both is best). Requests that match neither are rejected.
BMC_WEBHOOK_SECRET=
BMC_WEBHOOK_TOKEN=

# Turn features off entirely (hidden everywhere, no API calls, narrower OAuth scopes). true/false.
DISABLE_YOUTUBE_MEMBERS=false
DISABLE_TWITCH_SUBS=false

# Twitch chat is read anonymously. By default it follows the connected Twitch account;
# set this to read a different channel.
TWITCH_CHANNEL=

# Discord chat (optional). Bot token from the Developer Portal (enable Message Content Intent)
# and the channel ID(s) to show, comma separated.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_IDS=

# YouTube only reveals names of subscribers with PUBLIC subscriptions. When the count goes up and no name
# appears, an announcement for "Someone" is made. Set to 0 to stay silent for private subscribers.
YOUTUBE_ANON_SUBS=1
# Minutes to wait for a name before saying "Someone". The count and the names update separately, and announcing too
# early is what makes one new subscriber get announced twice.
YOUTUBE_ANON_WAIT_MIN=30

# ═══ Discord bot (Snitch for Magenta Forge) ═══
# The bot starts with the app once SNITCH_BOT_TOKEN is set. Values starting with PUT_ count as empty.
# Buy Me a Coffee events reach it through /webhooks/bmc above, so it has no port or webhook of its own.

# ---------- Discord: main bot (Snitch) ----------
# Developer Portal > Snitch > Bot > Reset Token. Also turn on Server Members Intent and Message Content Intent there.
SNITCH_BOT_TOKEN=PUT_SNITCH_BOT_TOKEN_HERE
# Developer Portal > Snitch > General Information > Application ID.
SNITCH_CLIENT_ID=PUT_SNITCH_CLIENT_ID_HERE
# Right-click the server icon > Copy Server ID (turn on Developer Mode first).
DISCORD_GUILD_ID=PUT_MAGENTA_FORGE_SERVER_ID_HERE
# The bot refuses to touch a server with any other name, because Snitch may be in other servers too.
DISCORD_GUILD_NAME=Magenta Forge

# ---------- Discord: ambience helper bots ----------
SNITCH_HELPER_1_TOKEN=PUT_SNITCH_HELPER_1_TOKEN_HERE
SNITCH_HELPER_1_CLIENT_ID=PUT_SNITCH_HELPER_1_CLIENT_ID_HERE
SNITCH_HELPER_2_TOKEN=PUT_SNITCH_HELPER_2_TOKEN_HERE
SNITCH_HELPER_2_CLIENT_ID=PUT_SNITCH_HELPER_2_CLIENT_ID_HERE
SNITCH_HELPER_3_TOKEN=PUT_SNITCH_HELPER_3_TOKEN_HERE
SNITCH_HELPER_3_CLIENT_ID=PUT_SNITCH_HELPER_3_CLIENT_ID_HERE
SNITCH_HELPER_4_TOKEN=PUT_SNITCH_HELPER_4_TOKEN_HERE
SNITCH_HELPER_4_CLIENT_ID=PUT_SNITCH_HELPER_4_CLIENT_ID_HERE
SNITCH_HELPER_5_TOKEN=PUT_SNITCH_HELPER_5_TOKEN_HERE
SNITCH_HELPER_5_CLIENT_ID=PUT_SNITCH_HELPER_5_CLIENT_ID_HERE
SNITCH_HELPER_6_TOKEN=PUT_SNITCH_HELPER_6_TOKEN_HERE
SNITCH_HELPER_6_CLIENT_ID=PUT_SNITCH_HELPER_6_CLIENT_ID_HERE
SNITCH_HELPER_7_TOKEN=PUT_SNITCH_HELPER_7_TOKEN_HERE
SNITCH_HELPER_7_CLIENT_ID=PUT_SNITCH_HELPER_7_CLIENT_ID_HERE
SNITCH_HELPER_8_TOKEN=PUT_SNITCH_HELPER_8_TOKEN_HERE
SNITCH_HELPER_8_CLIENT_ID=PUT_SNITCH_HELPER_8_CLIENT_ID_HERE
SNITCH_HELPER_9_TOKEN=PUT_SNITCH_HELPER_9_TOKEN_HERE
SNITCH_HELPER_9_CLIENT_ID=PUT_SNITCH_HELPER_9_CLIENT_ID_HERE
SNITCH_HELPER_10_TOKEN=PUT_SNITCH_HELPER_10_TOKEN_HERE
SNITCH_HELPER_10_CLIENT_ID=PUT_SNITCH_HELPER_10_CLIENT_ID_HERE

# ---------- Brand and links ----------
BRAND_COLOR=#ff267c
TWITCH_URL=https://twitch.tv/amaya.kulkarni
YOUTUBE_URL=https://youtube.com/@Amaya.Kulkarni
BMC_URL=https://buymeacoffee.com/amayakulkarni
BMC_RENEW_URL=https://buymeacoffee.com/amayakulkarni/membership

# ---------- Roles and tiers ----------
# The free role after a mod approves an intro.
TOURIST_NAME=Visitor

# Buy Me a Coffee tiers, cheapest first. The name must match the level's name on Buy Me a Coffee exactly: until
# TIER_n_BMC_ID is set, levels are matched by name. /tiers lists any level the bot does not recognise, with its ID.
TIER_1_NAME=Spark
TIER_1_PRICE=1
TIER_1_BMC_ID=PUT_SPARK_MEMBERSHIP_LEVEL_ID_HERE
TIER_1_PERKS=The Spark colour, #backstage and the Backstage voice room

TIER_2_NAME=Ember
TIER_2_PRICE=3
TIER_2_BMC_ID=PUT_EMBER_MEMBERSHIP_LEVEL_ID_HERE
TIER_2_PERKS=Everything in Spark, plus your name on the supporter wall and stream schedule previews

TIER_3_NAME=Forgehand
TIER_3_PRICE=5
TIER_3_BMC_ID=PUT_FORGEHAND_MEMBERSHIP_LEVEL_ID_HERE
TIER_3_PERKS=Everything in Ember, plus #forgehand-bench and a vote on what gets built or played next

TIER_4_NAME=Netrunner
TIER_4_PRICE=10
TIER_4_BMC_ID=PUT_NETRUNNER_MEMBERSHIP_LEVEL_ID_HERE
TIER_4_PERKS=Everything in Forgehand, plus #netrunner-den with build files, configs and early access to videos

TIER_5_NAME=Magenta Core
TIER_5_PRICE=25
TIER_5_BMC_ID=PUT_MAGENTA_CORE_MEMBERSHIP_LEVEL_ID_HERE
TIER_5_PERKS=Everything in Netrunner, plus #magenta-core and the Core Room: a direct line to Amaya

# ---------- Buy Me a Coffee ----------
# When a paid period passes with no event, off (recommended) tells the mods and takes nothing away. on starts the grace
# period automatically. Buy Me a Coffee documents no renewal event, so only turn this on after the log has shown a
# "renewal seen" line. Otherwise every paying member would lose their tier about a month in.
BMC_LAPSE_WITHOUT_RENEWAL=off
# Set to on only while testing with the dashboard's test events.
BMC_ACCEPT_TEST_EVENTS=off

# ---------- /link email codes (optional) ----------
# Without these, a mod approves each /link request instead of the member getting a code by email.
SMTP_HOST=PUT_SMTP_HOST_HERE
SMTP_PORT=587
SMTP_USER=PUT_SMTP_USER_HERE
SMTP_PASS=PUT_SMTP_PASSWORD_HERE
SMTP_FROM=PUT_FROM_ADDRESS_HERE

# ---------- Features ----------
AMBIENCE=on
POMODORO=on
# Forge Elder also needs a confirmed email (/link), as on the original server. Set to off to drop that step.
ELDER_REQUIRE_EMAIL=on
# DB_PATH=data/magenta-forge.db
