# Secrets: bot tokens, webhook secret, SMTP password
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Runtime data: the SQLite database holds member emails and Discord IDs
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Generated by `npm run setup:apply`: IDs of your own server's roles and channels
config/discord-tiers.json

# Local overrides (copy from the .example files)
config/ambience.json
config/pomodoro.json

# Ambience audio: generate with `npm run ambience:generate` or drop in tracks you have the rights to
audio/*
!audio/README.md

# Logs and tooling
logs/
*.log
npm-debug.log*
coverage/
.claude/
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
desktop.ini
